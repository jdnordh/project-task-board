{
  "name": "project-task-board",
  "version": "1.0.0",
  "description": "Grove \u2014 local single-user kanban board with a Claude column",
  "private": true,
  "scripts": {
    "dev": "concurrently -n server,client -c green,cyan \"npm run server\" \"npm run client\"",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "test": "npm --prefix server test",
    "typecheck": "npm --prefix client run typecheck",
    "feedback": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "concurrently": "^9.1.0"
  },
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jdnordh/project-task-board.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/jdnordh/project-task-board/issues"
  },
  "homepage": "https://github.com/jdnordh/project-task-board#readme"
}
